DATABASE_URL="postgresql://postgres:password@localhost:5432/restrocontrol?schema=public"
REDIS_URL="" # Optional; no Redis service required
JWT_SECRET="" # Generate at least 32 random bytes, never commit it
NEXT_PUBLIC_APP_NAME="RestroControl"
PORT=3000

# Native manual-UPI billing (preview). Off by default; never commit real values.
MANUAL_UPI_ENABLED="false"
MANUAL_UPI_VPA="" # Collection VPA shown on the payment QR; placeholder used when empty
MANUAL_UPI_PAYEE_NAME="RestroControl"
MANUAL_UPI_ALLOW_PLACEHOLDER="false" # true ONLY on non-payable preview deploys with the placeholder VPA
MANUAL_UPI_ADMIN_USER_IDS="" # Comma-separated user ids allowed to approve/reject payments
MANUAL_UPI_LAPSE_ENFORCEMENT="false" # true ONLY when the 72h-grace lapse policy is explicitly approved for that environment
