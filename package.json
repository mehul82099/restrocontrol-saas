{
  "name": "restrocontrol",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push",
    "prisma:seed": "node scripts/seed.js",
    "test": "node tests/reliability-regression.js && node tests/suite.js",
    "test:security": "node tests/security-regression.js",
    "typecheck": "tsc --noEmit",
    "test:reliability": "node tests/reliability-regression.js",
    "test:live-orders": "node tests/live-orders-regression.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@react-three/fiber": "^9.8.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.379.0",
    "next": "^15.5.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "three": "^0.160.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.160.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.19",
    "jiti": "^2.7.0",
    "postcss": "8.5.29",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6"
  }
}
